<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx" fx:controller="viewctrl.CartController">

    <Label styleClass="title" text="Shopping Cart" />

    <ListView fx:id="cartList" prefHeight="400.0" prefWidth="295.0"/>
   <Button mnemonicParsing="false" text="Remove Item" onAction="#removeProduct"/>

    <Button onAction="#goBack" text="Back" />

</VBox>
