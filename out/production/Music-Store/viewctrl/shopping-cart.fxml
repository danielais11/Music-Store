<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml"
      fx:controller="viewctrl.CartController" prefWidth="400" prefHeight="550">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Titel -->
    <Label text="Shopping Cart" styleClass="title"/>

    <!-- Produktliste -->
    <ListView fx:id="cartList" prefHeight="350" prefWidth="350"/>

    <!-- Gesamtpreis -->
    <HBox alignment="CENTER_RIGHT" spacing="10">

        <Label text="Total:"/>

        <Label fx:id="totalLabel" text="€0.00" styleClass="total-label"/>

    </HBox>

    <!-- Buttons -->
    <HBox alignment="CENTER" spacing="15">

        <Button text="Remove Item" onAction="#removeProduct" prefWidth="120"/>

        <Button text="Back" onAction="#goBack" prefWidth="90"/>

        <Button text="Checkout" onAction="#checkout" prefWidth="120"/>

    </HBox>

</VBox>