<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.HBox?>
<BorderPane xmlns="http://javafx.com/javafx/" xmlns:fx="http://javafx.com/fxml/1" fx:controller="viewctrl.Controller">

    <top>
        <VBox alignment="CENTER" spacing="10">
            <Button fx:id="closeButton" onAction="#closeWindow" text="Exit" />

            <HBox alignment="CENTER" spacing="15">

                <Button text="🛒" onAction="#openShoppingCart" prefWidth="120"/>

                <Button text="Inventory" onAction="#openInventory" prefWidth="120"/>


            </HBox>

            <Label styleClass="title" text="Music Store">
                <font>
                    <Font name="Calibri Light" size="12.0" />
                </font>
            </Label>

            <TextField fx:id="searchField" promptText="Search products..." onKeyReleased="#searchProducts" />
        </VBox>
    </top>

    <center>
        <ListView fx:id="productList" prefHeight="400.0" prefWidth="350.0" />
    </center>

    <bottom>

        <Button text="Add to Cart" onAction="#addToCart"/>
    </bottom>



</BorderPane>
