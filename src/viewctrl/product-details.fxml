<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="viewctrl.ProductDetailsController">

    <children>

        <Label fx:id="nameLabel" layoutX="30" layoutY="30" styleClass="title" text="Name" />

        <Label fx:id="categoryLabel" layoutX="30" layoutY="70" text="Category" />

        <Label fx:id="priceLabel" layoutX="30" layoutY="110" text="Price" />

        <TextArea fx:id="descriptionArea" layoutX="30" layoutY="150" prefHeight="200" prefWidth="250" styleClass="text-area" wrapText="true" />


        <TextArea fx:id="trackListArea" layoutX="300" layoutY="150" prefHeight="200" prefWidth="250" styleClass="text-area" wrapText="true" />

        <Button layoutX="38.0" layoutY="360.0" onAction="#goBack" prefWidth="80" text="Back" />
    </children>

</AnchorPane>
